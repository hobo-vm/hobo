<Project Sdk="Microsoft.NET.Sdk">
  <!-- hobo ui's backend in a Windows guest (designs/hobo-ui-linux-windows.md). Built in a Windows
       VM by `make windows-ui`, which commits the exe as Sources/HoboVM/Resources/UI/hobo-ui-windows.exe.
       .NET Framework 4.8.1 ships with Windows 11, natively for Arm, with the managed UI Automation
       client, so the exe needs nothing installed beside it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>hobo-ui-windows</AssemblyName>
    <RootNamespace>Hobo</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
